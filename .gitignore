# macOS / editors
.DS_Store
*.swp

# Written by tools at runtime, not config
.zcompdump*
__pycache__/
*.pyc
nohup.out
config/lazygit/state.yml
configstore/

# Installed by tpm (plugin list lives in tmux.conf; local patches in config/tmux/patches)
config/tmux/plugins/

# Raycast
/raycast/extentions/*

# Secrets never live here: secrets.zsh only looks keys up (Keychain / Doppler)
*.env
.env*

# Tool-made backups
*.bak
*.zwc

# Nix
result
result-*
